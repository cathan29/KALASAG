{
  "expo": {
    "name": "Kalasag",
    "slug": "kalasag",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#08111F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kalasag uses your location to show local weather, radar, and nearby disaster alerts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#EF4444",
          "defaultChannel": "critical-alerts"
        }
      ],
      "expo-font"
    ],
    "ios": {
      "bundleIdentifier": "com.cathan.kalasag",
      "icon": "./assets/icon.png",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kalasag uses your location to show nearby disaster alerts on the map."
      }
    },
    "android": {
      "package": "com.cathan.kalasag",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08111F"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "react-native-google-mobile-ads": {
        "android_app_id": "ca-app-pub-3940256099942544~3347511713",
        "ios_app_id": "ca-app-pub-3940256099942544~1458002511"
      },
      "eas": {
        "projectId": "b052fa86-2961-46b0-8d50-826159f0de38"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b052fa86-2961-46b0-8d50-826159f0de38"
    }
  }
}
